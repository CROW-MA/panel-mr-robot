# PANEL.SHOPPYWORLD.SITE - Variables de Entorno (EJEMPLO)
# Copiar a .env y completar con valores reales

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=panel_db
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña

# JWT
JWT_SECRET=genera_un_valor_aleatorio

# WhatsApp API
WHATSAPP_API_KEY=tu_api_key
WHATSAPP_WEBHOOK_URL=https://panel.shoppyworld.site/webhook

# IA
AI_PROVIDER=openai
AI_API_KEY=tu_api_key
AI_MODEL=gpt-4

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo
SMTP_PASS=tu_password
